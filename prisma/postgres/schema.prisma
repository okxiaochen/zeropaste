// PostgreSQL variant of the schema.
//
// Prisma's `provider` field does not accept env(), and the multi-provider array was removed from
// Prisma years ago, so each supported database gets its own schema file and its own generated
// client. Keep this file and prisma/sqlite/schema.prisma structurally identical; src/lib/db.ts
// assumes the two generated clients are interchangeable.
//
// Each schema lives in its own directory because Prisma resolves the migrations folder relative to
// the schema file. Two schemas side by side in prisma/ would share one migrations directory and
// overwrite each other's history.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single encrypted paste.
///
/// Everything the user actually wrote — content, language, title — lives inside `ciphertext`.
/// The columns below are the complete set of metadata the server is able to see. In particular
/// there is deliberately no column recording whether a password was set: that flag travels in the
/// URL fragment, which never reaches the server.
model Paste {
  /// 22-character base64url string, 128 bits of entropy.
  id         String   @id
  /// AES-256-GCM ciphertext with its authentication tag appended.
  ciphertext Bytes
  /// 12-byte AES-GCM nonce.
  iv         Bytes
  /// 16-byte salt, used for both Argon2id and HKDF. Not secret.
  salt       Bytes
  /// Serialised KDF parameters. Always written, even with no password, so that its presence
  /// reveals nothing.
  kdf        String
  /// Ciphertext length in bytes, kept for operational reporting.
  sizeBytes  Int
  createdAt  DateTime @default(now())
  /// Clamped server-side to createdAt + 90 days. Rows past this point are hard-deleted.
  expiresAt  DateTime

  @@index([expiresAt])
}
