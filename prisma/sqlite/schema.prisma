// SQLite variant of the schema. Keep structurally identical to prisma/postgres/schema.prisma.
//
// Note that Prisma does not support the Json scalar on SQLite, which is why `kdf` is a String
// holding JSON on both providers rather than Json on Postgres only — the two generated clients
// must stay interchangeable for src/lib/db.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// See prisma/postgres.prisma for field-by-field documentation.
model Paste {
  id         String   @id
  ciphertext Bytes
  iv         Bytes
  salt       Bytes
  kdf        String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
