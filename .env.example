# Copy to .env and fill in. Never commit .env.
# For deployment guidance, see docs/AGENT-DEPLOY.md.

# --- Database -----------------------------------------------------------------
# Either "sqlite" or "postgresql". Decided at deploy time; both are fully supported.
DATABASE_PROVIDER=sqlite

# sqlite:     file:/data/zeropaste.db          (inside the container; see docker-compose.yml)
# postgresql: postgresql://user:pass@host.docker.internal:5432/zeropaste?schema=public
#
# Prefer an ABSOLUTE path for SQLite. Prisma resolves a relative path against the directory holding
# the schema file, not the working directory, so `file:./dev.db` lands in prisma/sqlite/dev.db — and
# pointing two commands at what looks like the same relative path can silently create two databases.
DATABASE_URL=file:/tmp/zeropaste-dev.db

# --- Site ---------------------------------------------------------------------
# Optional canonical origin, used only for page metadata. Share links are built from the browser's
# own window.location.origin, so this does not need to be set for the site to work correctly, and
# changing your domain does not invalidate existing links.
#
# Regardless of this value: the site must be served over https:// on any hostname other than
# localhost. WebCrypto does not exist in insecure contexts. See docs/AGENT-DEPLOY.md §0.
BASE_URL=http://localhost:3000

# Host port published by docker compose.
PORT=3000

# --- Limits -------------------------------------------------------------------
# Maximum plaintext size accepted by the editor, in bytes. 0 disables the check.
MAX_PLAINTEXT_BYTES=10485760

# Above this size the viewer renders plain text instead of highlighting, to avoid freezing the tab.
HIGHLIGHT_LIMIT_BYTES=2097152

# --- Expiry purge -------------------------------------------------------------
# Run the purge loop inside the app process. Set false only if using an external scheduler.
PURGE_IN_PROCESS=true
PURGE_INTERVAL_MINUTES=15

# Bearer token for POST /api/cron/purge. Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Rate limiting (per IP) ---------------------------------------------------
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_READ_PER_MINUTE=120

# --- Security -----------------------------------------------------------------
# Enable only once HTTPS is confirmed working. Hard to undo.
ENABLE_HSTS=false
