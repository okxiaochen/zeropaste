# Copy to .env and fill in. Never commit .env.
# For deployment guidance, see docs/AGENT-DEPLOY.md.
#
# This file configures the SELF-HOSTED deployment. On Cloudflare, configuration lives in
# wrangler.jsonc and storage arrives as an R2 binding, so most of this does not apply.

# --- Storage ------------------------------------------------------------------
# Directory holding encrypted pastes, one file each. Inside the container this is the mounted volume.
# Deleting a paste overwrites its bytes before unlinking, so this should be local disk rather than a
# network mount, where the overwrite has no relationship to physical storage.
STORAGE_DIR=/data/pastes

# --- Site ---------------------------------------------------------------------
# Optional canonical origin, used only for page metadata. Share links are built from the browser's own
# window.location.origin, so this does not need to be set for the site to work, and changing your
# domain does not invalidate existing links.
#
# Regardless of this value: the site must be served over https:// on any hostname other than localhost.
# WebCrypto does not exist in insecure contexts. See docs/AGENT-DEPLOY.md.
BASE_URL=http://localhost:3000

# Host port published by docker compose.
PORT=3000

# --- Limits -------------------------------------------------------------------
# Maximum plaintext size accepted by the editor, in bytes. 0 disables the check.
MAX_PLAINTEXT_BYTES=10485760

# Above this size the viewer renders plain text instead of highlighting, to avoid freezing the tab.
HIGHLIGHT_LIMIT_BYTES=2097152

# --- Expiry sweep -------------------------------------------------------------
# Run the sweep inside the app process. Set false only if using an external scheduler.
PURGE_IN_PROCESS=true
PURGE_INTERVAL_MINUTES=15

# Bearer token for POST /api/cron/purge. Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Rate limiting (per IP) ---------------------------------------------------
# Counted in process memory, which is correct for a single container. Behind several replicas the
# effective limit multiplies by the replica count; put a real limiter at the proxy in that case.
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_READ_PER_MINUTE=120

# --- Security -----------------------------------------------------------------
# Enable only once HTTPS is confirmed working. Hard to undo.
ENABLE_HSTS=false
